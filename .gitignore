# =============================================================================
# Samvada Voice AI Backend — Git Ignore Rules
# Protects all environment configs, secrets, keys, database volumes, and logs
# =============================================================================

# --- Environment Files & Secrets ---
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
# Ensure example templates remain tracked for setup documentation
!.env.example
!*/.env.example

# --- SSL Certificates & Private Keys ---
*.pem
*.key
*.crt
*.cer
*.der
*.p12
*.pfx
*.keystore
ssl/
certs/

# --- API Keys, Credentials & Tokens ---
*secret*
*credential*
credentials.json
client_secret*.json
service-account*.json
token.json
jwt_private*
jwt_public*
id_rsa*
id_ed25519*

# --- Go Build Artifacts & Binaries ---
/bin/
bin/
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out
cover.out
coverage.html
profile.out

# --- Python Virtual Envs & Caches (Speech-to-Speech / Helper Services) ---
__pycache__/
*.py[cod]
*$py.class
.Python
env/
venv/
.venv/
ENV/
env.bak/
venv.bak/
.pytest_cache/
.coverage
htmlcov/
dist/
build/
*.egg-info/
.mypy_cache/

# --- Node / Tooling Dependencies ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Local Databases, Storage & Volume Mounts ---
*.sqlite
*.sqlite3
*.db
pgdata/
postgres-data/
clickhouse-data/
minio-data/
redis-data/
kafka-data/
zookeeper-data/
kratos-data/
hydra-data/

# --- Logs & Dumps ---
*.log
logs/
*.dump
*.sql.gz

# --- IDE & Operating System Artifacts ---
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
*.swo
*~
